{
  "name": "@persimmon/app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev:client": "expo start --dev-client",
    "dev:client:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:android": "expo run:android",
    "native:android:device": "expo run:android --device",
    "native:ios": "expo run:ios",
    "native:ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "bundle:android": "expo export --platform android --output-dir .expo/bundle-check/android",
    "bundle:ios": "expo export --platform ios --output-dir .expo/bundle-check/ios",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "postinstall": "node copy-canvaskit.js",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@expo-google-fonts/noto-serif-sc": "0.4.3",
    "@persimmon/book-core": "workspace:*",
    "@persimmon/epub-import": "workspace:*",
    "@persimmon/reader-skia": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-splash-screen": "~57.0.5",
    "idb": "8.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  }
}
