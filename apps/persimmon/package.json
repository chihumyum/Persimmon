{
  "name": "@persimmon/app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev:client": "expo start --dev-client",
    "dev:client:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:android": "expo run:android",
    "native:android:device": "expo run:android --device",
    "native:ios": "expo run:ios",
    "native:ios:device": "expo run:ios --device",
    "native:ios:release:device": "bash scripts/install-ios-release-device.sh",
    "bundle:android": "expo export --platform android --output-dir .expo/bundle-check/android",
    "bundle:ios": "expo export --platform ios --output-dir .expo/bundle-check/ios",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-math": "0.4.2",
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@expo-google-fonts/noto-serif-sc": "0.4.3",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "~57.0.9",
    "@persimmon/book-core": "workspace:*",
    "@persimmon/epub-import": "workspace:*",
    "@persimmon/font-core": "workspace:*",
    "@persimmon/reader-skia": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "^57.0.1",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  }
}
