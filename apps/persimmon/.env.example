# OAuth Client IDs are public identifiers, not client secrets.
# Native Client IDs already have public defaults in app.config.js. These
# variables are optional overrides.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=51752452441-gueqiurk1lrkeamljiqntn28ed6n5gg7.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=51752452441-8q55ns0e3k8h47q9h5uqa3487rui5639.apps.googleusercontent.com

# Public inbox shown by the in-app feedback composer. Do not use a private
# address; configure the same value in the EAS production environment.
EXPO_PUBLIC_SUPPORT_EMAIL=support@persimmon.cc
