{
  "expo": {
    "scheme": "persimmon",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["zh-Hans", "en"],
            "android": ["zh-Hans", "en"]
          }
        }
      ]
    ],
    "name": "Persimmon",
    "slug": "persimmon",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.chihum.persimmon",
      "icon": "./assets/icons/persimmon.icon",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.chihum.persimmon",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android/app-icon-foreground.png",
        "backgroundImage": "./assets/icons/android/app-icon-background.png",
        "monochromeImage": "./assets/icons/android/app-icon-monochrome.png"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30253096-6503-47de-9f5a-8a0a8ebd824e"
      }
    }
  }
}
