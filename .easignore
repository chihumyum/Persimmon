# Keep EAS uploads limited to source and build inputs. This file is evaluated
# from the repository root because Persimmon is a pnpm monorepo.

# Dependencies and local build products
node_modules/
.expo/
.gradle/
dist/
coverage/
*.tsbuildinfo

# Local corpora and previously generated release/QA artifacts
epubs-for-test/
artifacts/

# Expo CNG native projects are regenerated by EAS Build
apps/persimmon/android/
apps/persimmon/ios/
apps/persimmon/.expo/
apps/persimmon/dist/
apps/persimmon/expo-env.d.ts

# Local environment and signing material
.env*.local
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Editor and operating-system noise
.DS_Store
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
