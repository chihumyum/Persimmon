+  void emitStockMissLocked(int direction, double nowEpochMs,
+                           const char *reason = "stock-miss") {
+    _events.push_back(
+        {std::string(reason) + ":" +
+             std::to_string(++_stockMissCounter),
+         "stock-miss", nowEpochMs, direction < 0 ? -1 : 1});
