-                       JSI_EXPORT_FUNC(JsiSkSurfaceFactory, MakeOffscreen))
+                       JSI_EXPORT_FUNC(JsiSkSurfaceFactory, MakeOffscreen),
+                       JSI_EXPORT_FUNC(JsiSkSurfaceFactory,
+                                       configureCurrentThreadForRaster))

