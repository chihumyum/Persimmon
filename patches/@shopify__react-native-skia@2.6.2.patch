+  void schedule(std::function<void()> task) {
+    RNSkPagerDisplayLinkTarget *target = _target;
+    if (target == nil || !task) {
+      return;
+    }
+    if (NSThread.isMainThread) {
+      [target schedule:std::move(task)];
+    } else {
+      dispatch_async(dispatch_get_main_queue(), ^{
+        [target schedule:std::move(task)];
+      });
+    }
