+class RNSkDisplayLinkScheduler {
+public:
+  RNSkDisplayLinkScheduler() {
+    if (NSThread.isMainThread) {
+      _target = [[RNSkPagerDisplayLinkTarget alloc] init];
+    } else {
+      dispatch_sync(dispatch_get_main_queue(), ^{
+        _target = [[RNSkPagerDisplayLinkTarget alloc] init];
+      });
+    }
+  }
+
+  ~RNSkDisplayLinkScheduler() {
+    RNSkPagerDisplayLinkTarget *target = _target;
+    _target = nil;
+    if (NSThread.isMainThread) {
+      [target invalidate];
+    } else {
+      dispatch_async(dispatch_get_main_queue(), ^{
+        [target invalidate];
+      });
+    }
+  }
