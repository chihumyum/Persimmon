+  JSI_HOST_FUNCTION(configureCurrentThreadForRaster) {
+#if defined(__ANDROID__)
+    const int workerIndex =
+        count >= 1 && arguments[0].isNumber()
+            ? std::max(0, static_cast<int>(arguments[0].asNumber()))
+            : 0;
+    setpriority(
+        PRIO_PROCESS, 0, std::min(15, 5 + workerIndex * 3));
+
+    cpu_set_t allowedCpus;
+    CPU_ZERO(&allowedCpus);
+    if (sched_getaffinity(0, sizeof(allowedCpus), &allowedCpus) != 0) {
+      return jsi::Value(false);
+    }
+
+    struct CpuCapacity {
+      int cpu;
+      long capacity;
+    };
+    std::vector<CpuCapacity> capacities;
+    const long cpuCount = sysconf(_SC_NPROCESSORS_CONF);
+    for (int cpu = 0; cpu < cpuCount && cpu < CPU_SETSIZE; cpu += 1) {
+      if (!CPU_ISSET(cpu, &allowedCpus)) {
+        continue;
+      }
+      long capacity = 0;
+      std::ifstream capacityFile(
+          "/sys/devices/system/cpu/cpu" + std::to_string(cpu) +
+          "/cpu_capacity");
+      capacityFile >> capacity;
+      if (capacity <= 0) {
+        std::ifstream frequencyFile(
+            "/sys/devices/system/cpu/cpu" + std::to_string(cpu) +
+            "/cpufreq/cpuinfo_max_freq");
+        frequencyFile >> capacity;
+      }
+      capacities.push_back({cpu, capacity});
+    }
+    if (capacities.size() < 2) {
+      return jsi::Value(true);
+    }
+
+    std::sort(capacities.begin(), capacities.end(),
+              [](const CpuCapacity &left, const CpuCapacity &right) {
+      if (left.capacity != right.capacity) {
+        return left.capacity > right.capacity;
+      }
+      return left.cpu > right.cpu;
+    });
+    const int renderCpu = capacities.front().cpu;
+    capacities.erase(
+        std::remove_if(capacities.begin(), capacities.end(),
+                       [renderCpu](const CpuCapacity &capacity) {
+                         return capacity.cpu == renderCpu;
+                       }),
+        capacities.end());
+    if (capacities.empty()) {
+      return jsi::Value(true);
+    }
+    const auto rasterIndex = std::min(
+        static_cast<size_t>(workerIndex), capacities.size() - 1);
+    cpu_set_t rasterCpus;
+    CPU_ZERO(&rasterCpus);
+    CPU_SET(capacities[rasterIndex].cpu, &rasterCpus);
+    sched_setaffinity(0, sizeof(rasterCpus), &rasterCpus);
+    return jsi::Value(true);
+#else
+    return jsi::Value(false);
+#endif
+  }
+
