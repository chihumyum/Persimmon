+void configurePagerRenderThread() {
+  setpriority(PRIO_PROCESS, 0, -10);
+
+  cpu_set_t allowedCpus;
+  CPU_ZERO(&allowedCpus);
+  if (sched_getaffinity(0, sizeof(allowedCpus), &allowedCpus) != 0) {
+    return;
+  }
+
+  int selectedCpu = -1;
+  long selectedCapacity = -1;
+  const long cpuCount = sysconf(_SC_NPROCESSORS_CONF);
+  for (int cpu = 0; cpu < cpuCount && cpu < CPU_SETSIZE; cpu += 1) {
+    if (!CPU_ISSET(cpu, &allowedCpus)) {
+      continue;
+    }
+    long capacity = 0;
+    std::ifstream capacityFile(
+        "/sys/devices/system/cpu/cpu" + std::to_string(cpu) +
+        "/cpu_capacity");
+    capacityFile >> capacity;
+    if (capacity <= 0) {
+      std::ifstream frequencyFile(
+          "/sys/devices/system/cpu/cpu" + std::to_string(cpu) +
+          "/cpufreq/cpuinfo_max_freq");
+      frequencyFile >> capacity;
+    }
+    if (capacity > selectedCapacity ||
+        (capacity == selectedCapacity && cpu > selectedCpu)) {
+      selectedCpu = cpu;
+      selectedCapacity = capacity;
+    }
+  }
+  if (selectedCpu >= 0) {
+    cpu_set_t renderCpu;
+    CPU_ZERO(&renderCpu);
+    CPU_SET(selectedCpu, &renderCpu);
+    sched_setaffinity(0, sizeof(renderCpu), &renderCpu);
+  }
