{
  "name": "persimmon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "dev:native": "pnpm --filter @persimmon/app run dev:client",
    "dev:native:tunnel": "pnpm --filter @persimmon/app run dev:client:tunnel",
    "native:ios": "pnpm --filter @persimmon/app run native:ios",
    "native:ios:device": "pnpm --filter @persimmon/app run native:ios:device",
    "native:ios:release:device": "pnpm --filter @persimmon/app run native:ios:release:device",
    "release:ios": "tsx scripts/build-mobile-production.ts ios",
    "release:android": "tsx scripts/build-mobile-production.ts android",
    "publish:android:apk": "tsx scripts/publish-android-apk.ts",
    "native:android": "pnpm --filter @persimmon/app run native:android",
    "native:android:device": "pnpm --filter @persimmon/app run native:android:device",
    "native:android:release:device": "cd apps/persimmon/android && NODE_ENV=production ./gradlew :app:createBundleReleaseJsAndAssets --rerun-tasks -PreactNativeArchitectures=arm64-v8a --no-daemon && NODE_ENV=production ./gradlew :app:installRelease -PreactNativeArchitectures=arm64-v8a --no-daemon && rm -f app/build/outputs/apk/release/app-release.apk app/build/outputs/apk/release/app-release.dm",
    "native:release:devices": "bash -c 'pnpm native:ios:release:device & ios_process=$!; pnpm native:android:release:device & android_process=$!; wait \"$ios_process\"; ios_status=$?; wait \"$android_process\"; android_status=$?; (( ios_status == 0 && android_status == 0 ))'",
    "crash:android": "tsx scripts/capture-android-crash.ts",
    "crash:android:bugreport": "tsx scripts/capture-android-crash.ts --bugreport",
    "stress:android:page-turn": "tsx scripts/stress-android-page-turn.ts",
    "check:expo": "pnpm --filter @persimmon/app run doctor",
    "check:native-bundles": "pnpm --filter @persimmon/app run bundle:ios && pnpm --filter @persimmon/app run bundle:android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:epubs": "tsx scripts/validate-private-epubs.ts",
    "corpus:gutenberg": "tsx scripts/download-gutenberg-corpus.ts",
    "test:epubs:corpus": "tsx scripts/validate-epub-corpus.ts",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:expo && pnpm check:native-bundles"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@persimmon/epub-import": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.16.1",
    "expo-doctor": "1.20.1",
    "fflate": "0.8.3",
    "image-size": "1.2.1",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.1.2": "2.1.4",
      "brace-expansion@5.0.8": "5.0.9",
      "js-yaml@4.3.0": "4.3.1",
      "nanoid@3.3.16": "3.3.18",
      "postcss@8.5.22": "8.5.23",
      "uuid@7.0.3": "11.1.1"
    }
  }
}
